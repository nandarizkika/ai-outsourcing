  "business_glossary": {
    "GMV": {
      "name": "Gross Merchandise Value",
      "definition": "Total transaction value across all orders",
      "calculation": "SUM(amount_base) from transaction tables",
      "filters": [
        "status = 'SUCCESS'"
      ]
    },
    "active_users": {
      "name": "Active Users",
      "definition": "Users with at least one successful transaction",
      "calculation": "COUNT(DISTINCT user_id)",
      "filters": [
        "status = 'SUCCESS'"
      ]
    },
    "AOV": {
      "name": "Average Order Value",
      "definition": "Mean transaction value",
      "calculation": "AVG(amount_base)",
      "filters": [
        "status = 'SUCCESS'"
      ]
    },
    "conversion_rate": {
      "name": "Conversion Rate",
      "definition": "Percentage of orders completed successfully",
      "calculation": "COUNT(CASE WHEN status='SUCCESS') / COUNT(*) * 100"
    }
  },
