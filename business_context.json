      "definition": "Users with at least one successful transaction",
      "calculation": "COUNT(DISTINCT user_id)",
      "filters": [
        "status = 'SUCCESS'"
      ]
    },
    "AOV": {
      "name": "Average Order Value",
      "definition": "Mean transaction value",
      "calculation": "AVG(amount_base)",
      "filters": [
        "status = 'SUCCESS'"
      ]
    }
