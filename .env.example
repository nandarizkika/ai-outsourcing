# LLM Provider (options: gemini, openai, anthropic; default: gemini)
# Gemini is FREE with generous limits: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini

# API Keys — provide the key for your selected LLM provider
GEMINI_API_KEY=
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Slack Integration (optional)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_BOT_USER_ID=U0123456789   # From Slack app settings → Basic Information → Bot User ID

# Optional — Logging level (default: INFO)
LOG_LEVEL=INFO

# Optional — ChromaDB storage location (default: .chromadb)
CHROMADB_PERSIST_DIR=.chromadb

# Optional — Jira self-ticketing (leave blank to disable)
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=...
JIRA_PROJECT_KEY=AI

# Optional — Email channel (leave blank to disable)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_USER=you@example.com
EMAIL_IMAP_PASSWORD=...
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
